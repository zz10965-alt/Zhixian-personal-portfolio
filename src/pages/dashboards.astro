---
import { site, labels } from '../lib/content';
const page = site.pages.dashboards;
import Layout from '../layouts/Layout.astro';
import DashboardCard from '../components/DashboardCard.astro';
import { dashboards } from '../lib/content';
---
<Layout title={site.navigation.find(item => item.key === 'dashboards')!.label} pageKey="dashboards" description={page.seoDescription}><div class="container collection-page"><header class="page-heading"><p class="eyebrow">{page.eyebrow}</p><h1>{page.heading} <em>{page.emphasis}</em></h1><p>{page.description}</p></header><div class="dashboard-grid">{dashboards.map(dashboard => <DashboardCard dashboard={dashboard} />)}</div></div></Layout>
