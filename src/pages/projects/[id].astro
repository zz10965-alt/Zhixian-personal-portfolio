---
import Layout from '../../layouts/Layout.astro';
import DashboardCard from '../../components/DashboardCard.astro';
import ResourceLinks from '../../components/ResourceLinks.astro';
import Icon from '../../components/Icon.astro';
import { projects, dashboards, site, labels, usableLink, categoryLabel, mediaPath, sitePath } from '../../lib/content';
export function getStaticPaths() { return projects.map(project => ({params:{id:project.id},props:{project}})); }
const { project } = Astro.props;
const relatedDashboards = dashboards.filter(dashboard => dashboard.projectId === project.id);
const resources = project.resources.filter(resource => (!('verified' in resource) || resource.verified !== false) && usableLink(resource.url));
const hasResources = resources.length > 0 || relatedDashboards.length > 0;
const sections = project.sections.filter(section => section.paragraphs.some(text => text.trim()) || section.bullets.some(text => text.trim()) || section.images.some(image => image.src) || (section.id === 'resources' && hasResources));
if (hasResources && !sections.some(section => section.id === 'resources')) sections.push({id:'resources',title:labels.resources,paragraphs:[],bullets:[],images:[]});
const topResources = [...resources, ...relatedDashboards.flatMap(dashboard => dashboard.publicUrl && dashboard.publicUrlVerified && usableLink(dashboard.publicUrl) ? [{label:`${dashboard.platform} ${labels.dashboardLink}`,type:'dashboard',url:dashboard.publicUrl}] : dashboard.preview ? [{label:labels.dashboardScreenshot,type:'dashboard',url:dashboard.screenshots[0]?.image || dashboard.preview}] : [])];
---
<Layout title={site.navigation.find(item => item.key === 'projects')!.label} pageKey="projects" description={project.summary}>
  <div class="container case-page">
    <div class="case-topbar"><a class="text-link" href={sitePath('projects/')}><span aria-hidden="true">←</span> {labels.backProjects}</a><ResourceLinks resources={topResources} /></div>
    <header class="case-heading"><span class="category-badge">{categoryLabel(project.category)}</span><h1>{project.title}</h1><p>{project.summary}</p><div class="case-meta"><span>{project.dates}</span><span>{project.role}</span><span class="status-label">{project.status}</span></div><ul class="tags">{project.tags.map(tag => <li>{tag}</li>)}</ul>{project.note && <p class="content-review-note">{project.note}</p>}</header>
    <div class="case-layout">
      <aside class="case-toc"><details open><summary>{labels.onThisPage}</summary><nav aria-label={labels.projectSections}>{sections.map((section,index) => <a href={`#${section.id}`} data-section-link={section.id} aria-current={index === 0 ? 'location' : undefined}><span class="toc-number">{String(index + 1).padStart(2,'0')}</span>{section.title}</a>)}</nav></details></aside>
      <div class="case-content">{sections.map((section,index) => <section id={section.id} class="case-section" aria-labelledby={`heading-${section.id}`}>
        <p class="eyebrow">{String(index + 1).padStart(2,'0')}</p><h2 id={`heading-${section.id}`}>{section.title}</h2>
        {section.paragraphs.map(paragraph => <p>{paragraph}</p>)}
        {section.bullets.length > 0 && <ul>{section.bullets.map(bullet => <li>{bullet}</li>)}</ul>}
        {section.images.filter(image => image.src).map(image => <figure><a href={mediaPath(image.src)} target="_blank" rel="noopener noreferrer"><img src={mediaPath(image.src)} alt={image.alt} width="960" height="540" loading="lazy" /></a><figcaption>{image.caption}</figcaption></figure>)}
        {section.id === 'resources' && <><ResourceLinks resources={resources} />{relatedDashboards.map(dashboard => <DashboardCard dashboard={dashboard} showRelated={false} />)}</>}
      </section>)}</div>
    </div>
  </div>
  <script>
    const sections = [...document.querySelectorAll<HTMLElement>('.case-section')];
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-section-link]')];
    let scheduled = false;
    function update() {
      scheduled = false;
      let active = sections[0]?.id;
      for (const section of sections) if (section.getBoundingClientRect().top <= 120) active = section.id;
      if (window.scrollY > 0 && Math.ceil(window.innerHeight + window.scrollY) >= document.documentElement.scrollHeight - 2) active = sections.at(-1)?.id;
      links.forEach(link => { if (link.dataset.sectionLink === active) link.setAttribute('aria-current','location'); else link.removeAttribute('aria-current'); });
    }
    function schedule() { if (!scheduled) { scheduled = true; requestAnimationFrame(update); } }
    window.addEventListener('scroll', schedule, {passive:true});
    window.addEventListener('resize', schedule);
    window.addEventListener('load', schedule);
    links.forEach(link => link.addEventListener('click', event => {
      const section = sections.find(item => item.id === link.dataset.sectionLink);
      if (!section) return;
      event.preventDefault();
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      section.scrollIntoView({behavior:reducedMotion ? 'instant' : 'smooth',block:'start'});
      history.replaceState(null,'',`#${section.id}`);
    }));
    update();
  </script>
</Layout>
